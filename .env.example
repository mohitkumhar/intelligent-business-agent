# ==========================================
# Database Configuration
# ==========================================
# URL for connecting to the Postgres database
DATABASE_URL=postgresql://admin:root@db:5432/test_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=root
POSTGRES_DB=test_db

# pgAdmin Defaults
PGADMIN_DEFAULT_EMAIL=mohitmolela@gmail.com
PGADMIN_DEFAULT_PASSWORD=root

# ==========================================
# Agent / Backend Configuration
# ==========================================
# Number of maximum steps for the agent reasoning
AGENT_MAX_STEPS=22

# Path to local SQLite chat history if not using Postgres
CHAT_DB_PATH=chat_history.db

# Fallback business ID
DEFAULT_BUSINESS_ID=1

# Secret used for JWT authentication and session
JWT_SECRET=super-secret-business-key-2026
SECRET_KEY=super-secret-key-change-me

# Prometheus URL for querying metrics
PROMETHEUS_URL=http://prometheus:9090

# ==========================================
# LLM Providers (API Keys)
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_openrouter_model_here
OPENROUTER_SITE_NAME=your_site_name
OPENROUTER_SITE_URL=your_site_url

# ==========================================
# GitHub Configuration
# ==========================================
GITHUB_REPO=mohitkumhar/intelligent-business-agent

# ==========================================
# WhatsApp Gateway Configuration
# ==========================================
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
MY_WHATSAPP_NUMBER=91XXXXXXXXXX

# ==========================================
# Telegram Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ==========================================
# Slack Integration
# ==========================================
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_USER_ID=your_slack_bot_user_id

# Slack Channels/IDs mapped for smart assigner
SLACK_DEMO_CHANNEL_ID=your_demo_channel_id
SLACK_ID_BACKEND=backend_team_slack_id
SLACK_ID_DEFAULT=default_slack_id
SLACK_ID_ENGINEERING=engineering_team_slack_id
SLACK_ID_MARKETING=marketing_team_slack_id
SLACK_ID_SALES=sales_team_slack_id
SLACK_ID_UI_UX=ui_ux_team_slack_id

# ==========================================
# Frontend Services (Landing Page & Dashboard)
# ==========================================
# Internal communication URLs for docker network
BACKEND_URL=http://backend:5000
AGENT_API_URL=http://backend:5000

# Public URLs for external access/redirects
NEXT_PUBLIC_LANDING_URL=http://localhost:5173
NEXT_PUBLIC_VIEWER_URL=http://localhost:5173

# Vite exposed URLs
VITE_API_URL=http://backend:5000
VITE_AGENT_API_URL=http://localhost:5000
VITE_DASHBOARD_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Auth & Security
ENCRYPTION_SECRET=12345678901234567890123456789012
NEXTAUTH_URL=http://localhost:5173
