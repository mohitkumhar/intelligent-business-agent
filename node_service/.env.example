# ==========================================================
# AI Business Helper — Node backend + WhatsApp/Telegram bots
# Copy to .env and fill in real values.  NEVER commit .env.
# ==========================================================

# ---------- Backend ----------
# Port the Express backend listens on.
PORT=3000

# Base URL the bots use to reach the backend. Keep as localhost when running
# everything on one machine.
BACKEND_URL=http://localhost:3000

# Max JSON body size. Phone photos are large once base64-encoded.
JSON_BODY_LIMIT=15mb


# ---------- Core LLM (business advisor) ----------
# OpenRouter serves the advisor. It speaks the OpenAI format but routes to Claude,
# so this reuses the key already used elsewhere in the project.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Any OpenRouter model id. Swap this to change models without touching code.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Optional attribution shown on the OpenRouter dashboard.
OPENROUTER_SITE_NAME=AI Business Helper
OPENROUTER_SITE_URL=http://localhost:3000

# Abort an LLM call after this many ms.
LLM_TIMEOUT_MS=60000


# ---------- Gemini (photo OCR) ----------
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vision-capable Gemini model used to transcribe photos.
GEMINI_MODEL=gemini-3.6-flash

# Abort an OCR call after this many ms.
GEMINI_TIMEOUT_MS=45000


# ---------- Session storage ----------
# Conversation turns kept per session (1 turn = 1 user message + 1 reply).
MAX_HISTORY_TURNS=20

# Drop a session after this long with no activity (default 24h).
SESSION_TTL_MS=86400000


# ---------- WhatsApp bot ----------
# The number whose WhatsApp is QR-linked to HOST the bot. Logging/display only.
WHATSAPP_BOT_NUMBER=7976127452

# Comma-separated WhatsApp IDs the bot is allowed to reply to.
# Format: <country code><number>@c.us  — e.g. +91 99265 65563 -> 919926565563@c.us
# Anything not listed here is logged and ignored: no reply, no API call.
# Leave EMPTY and the bot ignores everyone (safe default).
WHATSAPP_ALLOWED_IDS=919926565563@c.us

# Where the linked WhatsApp session is cached, so restarts skip the QR scan.
WHATSAPP_SESSION_PATH=./.wwebjs_auth


# ---------- Telegram bot ----------
# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated numeric chat ids the bot may reply to.
# LEAVE EMPTY on first run: the bot enters DISCOVERY MODE, logs the chat.id of
# anyone who messages it, and replies to nobody. Copy your id from the console
# into this variable, then restart.
TELEGRAM_ALLOWED_CHAT_IDS=
